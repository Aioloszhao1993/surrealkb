# 复制为 .env 并按需修改
APP_NAME=SurrealKB
# 【必填】JWT 签名密钥：必须是足够长的随机串（≥16 位），留空或过弱会拒绝启动。
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 仅本地临时调试可设 true 放行弱密钥（会打印警告）；生产务必 false
ALLOW_INSECURE_SECRET=false

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=video_fastqpi
# 可选：直接指定完整连接串（留空则用上面的 MySQL 参数拼接）
DATABASE_URL_OVERRIDE=

# 允许跨域的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 上传文件存储目录（相对 backend 目录）
UPLOAD_DIR=uploads
# 头像最大体积（MB）
MAX_AVATAR_MB=5

# ===== 微信扫码登录（微信开放平台「网站应用」）=====
# 留空 => 自动进入本地 Mock 模式（二维码指向本机模拟授权页，无需真实公众号即可演示）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 网站应用授权回调（必须与开放平台后台配置一致）
WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wx/callback
# Mock 二维码里指向的本机地址（前端能从手机访问时改成局域网 IP）
PUBLIC_BASE_URL=http://localhost:8000
WX_STATE_TTL_SECONDS=600
# 是否允许「无真实 AppID 时的模拟扫码登录」（本地开发 true，生产 false）
ENABLE_WECHAT_MOCK=true
# 是否开放 /api/auth/wx/virtual 一键虚拟登录（无鉴权！仅本地开发，生产必须 false）
ENABLE_VIRTUAL_LOGIN=false

# ===== AI 助手（阿里云百炼 / DashScope）=====
# 去百炼控制台申请 API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
AI_CHAT_MODEL=qwen-plus
AI_EMBED_MODEL=text-embedding-v3
AI_EMBED_DIM=1024
# 每次问答检索返回的分块数：越大越全面、上下文越长（3~5 较平衡）
AI_TOP_K=4

# ===== 知识库 / 文档 =====
# 单个文档最大体积（MB）
MAX_DOC_MB=50
# 分块目标长度（字）与块间重叠（字）
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 是否允许用户自助新建知识库
ALLOW_NEW_TENANT=true