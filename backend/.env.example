# 复制为 .env 并按需修改
APP_NAME=SurrealVideo
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=video_fastqpi
# 可选：直接指定完整连接串（留空则用上面的 MySQL 参数拼接）
DATABASE_URL_OVERRIDE=

# 允许跨域的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 上传文件存储目录（相对 backend 目录）
UPLOAD_DIR=uploads
# 单个视频最大体积（MB）
MAX_VIDEO_MB=1024
# 头像最大体积（MB）
MAX_AVATAR_MB=5

# ===== 微信扫码登录（微信开放平台「网站应用」）=====
# 留空 => 自动进入本地 Mock 模式（二维码指向本机模拟授权页，无需真实公众号即可演示）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 网站应用授权回调（必须与开放平台后台配置一致）
WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wx/callback
# Mock 二维码里指向的本机地址（前端能从手机访问时改成局域网 IP）
PUBLIC_BASE_URL=http://localhost:8000
WX_STATE_TTL_SECONDS=600

# ===== AI 助手（阿里云百炼 / DashScope）=====
# 去百炼控制台申请 API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
AI_CHAT_MODEL=qwen-plus
AI_EMBED_MODEL=text-embedding-v3
AI_EMBED_DIM=1024
AI_TOP_K=3