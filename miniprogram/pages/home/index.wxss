/* 首页：与主站一致的深色霓虹风格（page 背景已在 app.wxss 全局定义） */
.wrap {
  min-height: 100vh;
  padding: 80rpx 48rpx 60rpx;
  box-sizing: border-box;
}

/* 品牌菱形：纯 CSS 绘制，不占用图片体积 */
.logo {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 32rpx;
  border-radius: 28rpx;
  transform: rotate(45deg);
  background: linear-gradient(135deg, #00e5ff, #9b59ff);
  box-shadow: 0 0 80rpx rgba(155, 89, 255, 0.45);
}

.brand {
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #f0ecff;
}

.slogan {
  text-align: center;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b79dff;
}

.card {
  margin-top: 40rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(155, 89, 255, 0.3);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #e6dfff;
  margin-bottom: 20rpx;
}

.card-body {
  font-size: 26rpx;
  line-height: 1.8;
  color: #a99fd0;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.num {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #04120d;
  background: linear-gradient(135deg, #34ffab, #00e5ff);
}

.step-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #c9bfff;
}

.tip {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(155, 89, 255, 0.22);
  font-size: 24rpx;
  line-height: 1.75;
  color: #8a80b5;
}

.links {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.link {
  font-size: 25rpx;
  color: #9b86e0;
  padding: 12rpx 0;
}

.icp {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6f6799;
}
